# Run from Watchdog's module root. Reuses the canonical native adapter.
from telemetry_native_adapter import watchdog_native_batch_normalize
func normalize_file(input, output) {
    payload := parse_json(read_file(input))
    result := watchdog_native_batch_normalize("agent-city-sdk", "1", payload["batch_id"], payload["events"])
    assert(result["ok"], "Watchdog native normalization failed")
    write_file(output, to_json(result["batch"]), true)
}
if env_or("CITY_NORMALIZE_WORK", "") != "" {
    jobs := parse_json(read_file(env_or("CITY_NORMALIZE_WORK", "")))
    assert(type(jobs) == "array" && len(jobs) > 0 && len(jobs) <= 16, "Invalid normalization work size")
    for job in jobs { normalize_file(job["input"], job["output"]) }
} else {
    normalize_file(env_or("CITY_NATIVE_INPUT", ""), env_or("CITY_CANONICAL_OUTPUT", ""))
}
