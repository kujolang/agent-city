# Invoked from the Agents SDK module root by the private VideoOps stage runner.
from src.agents.ai.adapter import create_ai_sdk_adapter
from src.agents.runner import create_agent_runner, run_agent
from src.agents.core_types import create_agent, create_agent_run_request
from src.agents.tracing.lifecycle import create_lifecycle_spool

request := parse_json(read_file(env_or("CITY_VIDEOOPS_REQUEST", "")))
assert(request["schema"] == "agent-city.videoops-stage.v1", "Unsupported stage request")
endpoint := env_or("CITY_MODEL_ENDPOINT", "")
model := env_or("CITY_MODEL", "")
assert(endpoint != "" && model != "", "Configure a provider")
sink := create_lifecycle_spool(env_or("CITY_SPOOL", ""), 262144)
adapter := create_ai_sdk_adapter({"chat_completion_fn": func(client, messages, options) {
    headers := {"Content-Type":"application/json"}
    key := env_or("CITY_MODEL_API_KEY", "")
    if key != "" { headers["Authorization"] := "Bearer "+key }
    try {
        wire := http_request(endpoint, {
            "method":"POST", "headers":headers,
            "body":to_json({"model":model,"messages":messages,"stream":false,"max_tokens":request["maxOutputTokens"]}),
            "timeout":request["timeoutSeconds"],"redirects":"none","max_response_bytes":1048576
        })
        match wire {
            case Ok(response): {
                if response["_status"] < 200 || response["_status"] >= 300 {
                    return {"ok":false,"error":{"code":"provider_http_error","message":"Stage provider rejected request"}}
                }
                body := parse_json(response["_body"])
                choice := body["choices"][0]
                message := choice["message"]
                # Models cannot grant themselves tools through text or tool envelopes.
                if has_key(message,"tool_calls") || has_key(message,"function_call") {
                    return {"ok":false,"error":{"code":"tool_unavailable","message":"Stage provider requested an ungranted tool"}}
                }
                content := message["content"]
                if type(content) != "string" || trim(content) == "" {
                    return {"ok":false,"error":{"code":"empty_response","message":"No stage output"}}
                }
                write_file(env_or("CITY_VIDEOOPS_RAW", ""),content,true)
                if has_key(choice,"finish_reason") && choice["finish_reason"] != "stop" {
                    return {"ok":false,"error":{"code":"incomplete_response","message":"Stage response did not finish normally; raw output retained"}}
                }
                return {"ok":true,"status_code":200,"data":body,"text":content}
            }
            case Err(error): { return {"ok":false,"error":{"code":"provider_unavailable","message":"Stage provider unavailable"}} }
        }
    } except invalid { return {"ok":false,"error":{"code":"invalid_response","message":"Stage provider response invalid"}} }
}})
agent := create_agent({"id":request["stage"],"instructions":request["instructions"],"timeout_ms":(request["timeoutSeconds"]+30)*1000})
result := run_agent(create_agent_runner({"ai_adapter":adapter}),agent,create_agent_run_request(request["input"],{"run_id":request["run"]}),{
    "producer_instance":request["producer"],"observation_profile":request["profile"],
    "observation_task_id":request["task"],"observation_attempt":request["attempt"],
    "on_lifecycle":sink,"max_iterations":8
})
write_file(env_or("CITY_VIDEOOPS_RESULT", ""),to_json({"status":result["status"],"run":request["run"],"stage":request["stage"]}),true)
assert(result["status"] == "completed","VideoOps model stage failed; receipt retained")
