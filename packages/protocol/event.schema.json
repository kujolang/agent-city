                  "maxLength": 160
                },
                "workcellRef": {
                  "type": "string",
                  "maxLength": 160
                },
                "relatedInstance": {
                  "type": "string",
                  "maxLength": 160
                },
                "appearance": {
                  "type": "string",
                  "maxLength": 160
                },
                "station": {
                  "type": "string",
                  "maxLength": 160
                }
              }
            }
          }
        }
      }
