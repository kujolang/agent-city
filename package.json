{
  "name": "kujo-agent-city",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "vite build apps/web --outDir ../../dist --emptyOutDir",
    "dev": "vite apps/web --host 127.0.0.1",
    "gateway": "tsx apps/gateway/main.ts",
    "verify": "npm run typecheck && npm run boundaries && npm run maps && npm test && npm run build",
    "generate": "tsx scripts/generate-protocol.ts",
    "maps": "tsx scripts/compile-maps.ts",
    "boundaries": "tsx scripts/boundaries.ts",
    "proof": "tsx scripts/browser-proof.ts",
    "bridge": "tsx integrations/kujo/bridge.ts",
    "local": "tsx scripts/local.ts",
    "demo": "tsx scripts/demo.ts",
    "recovery": "tsx scripts/recovery-proof.ts",
    "format": "prettier --write \"apps/**/*.ts\" \"packages/**/*.ts\" \"integrations/**/*.ts\" \"scripts/*.ts\" \"tests/*.ts\"",
    "proof:phase1": "tsx scripts/phase1-proof.ts",
    "workcell": "tsx integrations/kujo/workcell.ts",
    "stress": "tsx scripts/stress.ts",
    "proof:hardening": "tsx scripts/browser-hardening.ts",
    "soak": "tsx scripts/scale-soak.ts",
    "replay": "tsx scripts/replay.ts",
    "gate": "tsx scripts/release-gate.ts",
    "proof:pipeline": "tsx scripts/pipeline-blockers.ts"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "pixi.js": "8.20.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.10.1",
    "json-schema-to-typescript": "15.0.4",
    "prettier": "3.6.2",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  },
  "version": "0.2.0-rc.1"
}
