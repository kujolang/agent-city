    "previousArtifact": "/**\n * Sum an array of finite numbers. Throws TypeError for invalid input.\n *\n * @param {number[]} values Array of numbers.\n * @returns {number} Sum of array elements.\n */\nfunction sum(values) {\n    if (!Array.isArray(values) || !values.every(Number.isFinite)) {\n        throw new TypeError(\"Input array must contain only finite numbers.\");\n    }\n    return values.reduce((acc, curr) => acc + curr, 0);\n}\n\n// Example usage:\ntry {\n    console.log(sum([1, 2, 3])); // Output: 6\n    // Uncomment the following line to test for invalid input\n    // console.log(sum([1, 'a', 3])); // Throws TypeError\n} catch (error) {\n    console.error(error.message);\n}\n",
