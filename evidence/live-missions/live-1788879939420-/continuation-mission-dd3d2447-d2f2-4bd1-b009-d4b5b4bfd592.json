    "kind": "code",
    "content": "/**\n * Calculate the sum of a numeric array. Throws TypeError for invalid input.\n * @param {number[]} values - The array of numbers to sum.\n * @returns {number} The sum of the array elements.\n */\nexport function sum(values) {\n    if (!Array.isArray(values) || !values.every(Number.isFinite)) {\n        throw new TypeError(\"Input array must contain only finite numbers.\");\n    }\n    return values.reduce((acc, curr) => acc + curr, 0);\n}\n",
