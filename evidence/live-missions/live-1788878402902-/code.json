  "artifact": {
    "id": "mission-958cba16-9bd9-4a41-8aab-1023f9c5577b",
    "kind": "code",
    "content": "export function sum(values) {\n  if (!Array.isArray(values) || !values.every(val => typeof val === 'number' && Number.isFinite(val))) {\n    throw new TypeError('Invalid input');\n  }\n  return values.reduce((acc, val) => acc + val, 0);\n}\n",
